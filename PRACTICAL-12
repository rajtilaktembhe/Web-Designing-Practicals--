<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Modern Bootstrap Page</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      font-family: Arial, sans-serif;
    }
    .hero-text {
      position: absolute;
      top: 50%;
      left: 10%;
      transform: translateY(-50%);
      color: white;
    }
    .btn-gradient {
      background: linear-gradient(45deg, #007bff, #6610f2);
      color: white;
      border: none;
    }
    .btn-gradient:hover {
      opacity: 0.9;
    }
    .footer-links a {
      color: #ccc;
      text-decoration: none;
    }
    .footer-links a:hover {
      color: white;
    }
  </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light shadow">
  <div class="container">
    <a class="navbar-brand fw-bold" href="#">BrandX</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link active" href="#">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Services</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Portfolio</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- Carousel with Hero Text -->
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
  <div class="carousel-inner">

    <div class="carousel-item active">
      <img src="https://via.placeholder.com/1200x500/343a40/ffffff" class="d-block w-100">
      <div class="hero-text">
        <h1>Welcome to BrandX</h1>
        <p>We build modern solutions</p>
        <button class="btn btn-gradient">Get Started</button>
      </div>
    </div>

    <div class="carousel-item">
      <img src="https://via.placeholder.com/1200x500/6c757d/ffffff" class="d-block w-100">
      <div class="hero-text">
        <h1>Creative Designs</h1>
        <p>Designs that stand out</p>
      </div>
    </div>

    <div class="carousel-item">
      <img src="https://via.placeholder.com/1200x500/212529/ffffff" class="d-block w-100">
      <div class="hero-text">
        <h1>Grow Your Business</h1>
        <p>Scale with confidence</p>
      </div>
    </div>

  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>

  <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</div>

<!-- Cards Section -->
<div class="container py-5">
  <h2 class="text-center mb-4">Our Services</h2>
  <div class="row g-4">

    <div class="col-md-4">
      <div class="card shadow-sm border-0">
        <div class="card-body text-center">
          <h5 class="card-title">Web Development</h5>
          <p class="card-text">Responsive and modern websites.</p>
          <button class="btn btn-gradient">Learn More</button>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm border-0">
        <div class="card-body text-center">
          <h5 class="card-title">UI/UX Design</h5>
          <p class="card-text">User-friendly interface designs.</p>
          <button class="btn btn-gradient">Learn More</button>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm border-0">
        <div class="card-body text-center">
          <h5 class="card-title">Marketing</h5>
          <p class="card-text">Grow your digital presence.</p>
          <button class="btn btn-gradient">Learn More</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Button Section -->
<div class="container text-center mb-5">
  <h3>Quick Actions</h3>
  <div class="mt-3">
    <button class="btn btn-outline-primary me-2">Sign Up</button>
    <button class="btn btn-outline-success me-2">Login</button>
    <button class="btn btn-outline-danger">Subscribe</button>
  </div>
</div>

<!-- Footer -->
<footer class="bg-dark text-light pt-4">
  <div class="container">
    <div class="row">

      <div class="col-md-4">
        <h5>About</h5>
        <p>We create high-quality digital solutions for businesses worldwide.</p>
      </div>

      <div class="col-md-4 footer-links">
        <h5>Links</h5>
        <p><a href="#">Home</a></p>
        <p><a href="#">Services</a></p>
        <p><a href="#">Contact</a></p>
      </div>

      <div class="col-md-4">
        <h5>Contact</h5>
        <p>Email: info@brandx.com</p>
        <p>Phone: +91 98765 xxxxx</p>
      </div>

    </div>

    <div class="text-center mt-3 pb-3">
      <small>&copy; 2026 BrandX. All rights reserved.</small>
    </div>
  </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
